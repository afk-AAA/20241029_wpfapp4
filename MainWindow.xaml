<Window x:Class="_20241029_wpfapp4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:_20241029_wpfapp4"
        mc:Ignorable="d"
        
        Title="WPF小畫家ver2" Height="525" Width="940">
    <Grid>
        <DockPanel LastChildFill="False" Margin="0,0,0,0">
            <Menu Height="30" DockPanel.Dock="Top">
                <MenuItem Height="25" Header="檔案" VerticalAlignment="Center">
                    <MenuItem Header="新增畫布"/>
                    <MenuItem Header="開啟檔案"/>

                </MenuItem>
                
            </Menu>
            <ToolBarTray Height="40" DockPanel.Dock="Top">
                <ToolBar Height="38" Width="550" Background="LightGreen">
                    <Label Content="筆刷顏色" FontSize="14"  FontWeight="Bold"
                        VerticalContentAlignment="Center"/>
                    <xctk:ColorPicker x:Name="strockeColorPicker" Width="50" 
                        SelectedColorChanged="strockeColorPicker_SelectedColorChanged"/>
                    <Label Content="填滿顏色" FontSize="14"  FontWeight="Bold"
                        VerticalContentAlignment="Center"/>
                    <xctk:ColorPicker x:Name="fillColorPicker" Width="50" 
                        SelectedColorChanged="fillColorPicker_SelectedColorChanged"/>
                    <Slider x:Name="strokeThicknessSlider" Width="120"
                            VerticalAlignment="Center" Value="1" Minimum="1" 
                            IsSnapToTickEnabled="True" Margin="20,0,0,0" ValueChanged="strokeThicknessSlider_ValueChanged"/>
                    <Label Width="40" Margin="10,0,0,0" 
                           Content="{Binding Value, ElementName=strokeThicknessSlider}"
                           FontSize="14" Foreground="CornflowerBlue" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </ToolBar>
                <ToolBar Height="38" Width="300" Background="SkyBlue">
                    <RadioButton Width="38" Height="38" Click="ShapeButton_Click" 
                                 Tag="line">
                        <Image Height="36" Width="36" Source="/line.png"/>
                    </RadioButton>
                    <RadioButton Width="38" Height="38" Click="ShapeButton_Click" 
                                 Tag="rectangle">
                        <Image Height="36" Width="36" Source="/rectangle.png"/>
                    </RadioButton>
                    <RadioButton Width="38" Height="38" Click="ShapeButton_Click" 
                                 Tag="ellipse">
                        <Image Height="36" Width="36" Source="/ellipse.png"/>
                    </RadioButton>
                    <RadioButton Width="38" Height="38" Click="ShapeButton_Click" 
                                 Tag="polyline">
                        <Image Height="36" Width="36" Source="/polyline.png"/>
                    </RadioButton>
                    <Separator/>
                    <RadioButton Width="38" Height="38" Click="EraserButton_Click" 
                                 Tag="eraser">
                        <Image Height="36" Width="36" Source="/eraser.png"/>
                    </RadioButton>
                    <RadioButton Width="38" Height="38" Click="ClearButton_Click" 
                                 Tag="clear">
                        <Image Height="36" Width="36" Source="/trashcan.png"/>
                    </RadioButton>
                </ToolBar>
            </ToolBarTray>
            <Canvas x:Name="myCanvas" Width="700" Background="Beige"
                    DockPanel.Dock="Top" Height="353" 
                    MouseEnter="myCanvas_MouseEnter"
                    MouseLeftButtonDown="myCanvas_MouseLeftButtonDown"
                    MouseMove="myCanvas_MouseMove" MouseUp="myCanvas_MouseUp"/>
            <StatusBar Height="35" DockPanel.Dock="Bottom" 
                       Background="LightGray"  >
                <StatusBarItem>
                    <Label x:Name="statusLabel" Content="Ready" FontSize="14"/>
                </StatusBarItem>
                <StatusBarItem>
                    <Label x:Name="statusPoint" Content="(0, 0) - (0, 0)" FontSize="14"/>
                </StatusBarItem>
            </StatusBar>
        </DockPanel>

    </Grid>
</Window>
